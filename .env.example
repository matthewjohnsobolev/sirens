# ==============================================================================
# Telegram
# ==============================================================================
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Active broadcast sources ("fallback", "primary", or comma-separated "primary,fallback").
# By default only fallback broadcasts alerts; primary remains in telemetry/healthchecks.
ALERT_BROADCAST_SOURCES=fallback


# ==============================================================================
# Database & Cache
# ==============================================================================
POSTGRES_USER=sirens
POSTGRES_PASSWORD=sirens
POSTGRES_DB=sirens
DATABASE_URL=postgresql://sirens:sirens@localhost:5432/sirens
REDIS_URL=redis://localhost:6379/0

# ==============================================================================
# Cloudflare R2 Storage (BI)
# ==============================================================================
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BI_DATA_BUCKET=sirens-bi-data
CLOUDFLARE_R2_BI_WEB_BUCKET=sirens-bi-web
CLOUDFLARE_R2_S3_ENDPOINT=

# ==============================================================================
# Cloudflare KV (Status Page Telemetry)
# ==============================================================================
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_TELEMETRY_NAMESPACE_ID=

# ==============================================================================
# Healthchecks.io Monitoring
# ==============================================================================
HEALTHCHECKS_API_KEY=
HEALTHCHECKS_ALERTS_SOURCE_PING_URL=
HEALTHCHECKS_ALERTS_BROADCAST_PING_URL=
HEALTHCHECKS_WEB_PING_URL=
HEALTHCHECKS_BACKUP_PING_URL=
HEALTHCHECKS_BI_PING_URL=
HEALTHCHECKS_ALERTS_SOURCE_SLUG=sirens-alerts-source
HEALTHCHECKS_ALERTS_BROADCAST_SLUG=sirens-alerts-broadcast

# ==============================================================================
# UptimeRobot Monitoring
# ==============================================================================
UPTIMEROBOT_API_MONITOR_KEY=
UPTIMEROBOT_WEB_MONITOR_KEY=

# ==============================================================================
# App & Web
# ==============================================================================
APP_ENV=dev
SENTRY_DSN=
# Public origins used for canonical tags and the sitemap.
# Підкладка мапи (безлейбловий растр CARTO). Без ключа кожна плитка
# приїжджає з написом «API KEY REQUIRED» упоперек.
MAP_TILES_API_KEY=cb1_2yb9_1_ad9ea4ba1d81818dcc001989
# Інший провайдер — задайте всю адресу й обов'язково змініть кредит:
# показувати чужі тайли з чужим підписом — порушення ліцензії.
# MAP_TILES_URL=https://{s}.basemaps.cartocdn.com/light_nolabels/{z}/{x}/{y}{r}.png
# MAP_TILES_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>

SITE_URL=https://sirens.live
STATUS_URL=https://status.sirens.live
# GA4 measurement ID. Leave empty to serve the pages without any analytics.
GA_MEASUREMENT_ID=G-JC48ZJGBHM
GITHUB_PAT=
GITHUB_REPO=matthewjohnsobolev/sirens

# ==============================================================================
# Backup (OCI Object Storage)
# ==============================================================================
OCI_PAR_URL=