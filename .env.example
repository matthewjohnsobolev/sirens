TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Вхід ланцюга: зелений, поки джерело говорить, а з'єднання з Telegram живе
HEALTHCHECKS_PING_URL_ALERTS_SOURCE=
# Вихід ланцюга: вердикт останньої спроби бродкасту в канали мережі
HEALTHCHECKS_PING_URL_ALERTS_BROADCAST=
HEALTHCHECKS_PING_URL_WEB=
HEALTHCHECKS_PING_URL_BACKUP=
HEALTHCHECKS_PING_URL_BI=
# Read-only ключ Management API: з нього живиться сторінка /status
HEALTHCHECKS_API=
# Необов'язково. Дата, з якої історія вважається достовірною (YYYY-MM-DD).
# Порожнє значення означає «рахувати від найранішого флипа».
STATUS_START_DATE=
# Точні slug чеків для компонентів сторінки стану. Обов'язкові: без них
# компонент лишається без моніторингу - здогадок за назвою більше немає.
HEALTHCHECKS_SLUG_ALERTS_SOURCE=sirens-alerts-source
HEALTHCHECKS_SLUG_ALERTS_BROADCAST=sirens-alerts-broadcast
# UptimeRobot: зовнішня перевірка того, що сайт і API відкриваються ззовні.
# Ключі помоніторні (Monitor -> Settings -> API key): такий ключ віддає рівно
# свій монітор, тож зіставляти нічого не доводиться.
UPTIMEROBOT_SIRENS_API_API=
UPTIMEROBOT_SIRENS_WEB_API=
SENTRY_DSN=
APP_MODE=
FLASK_SECRET_KEY=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
OCI_PAR_URL=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_DATA_BUCKET=
CLOUDFLARE_R2_WEB_BUCKET=
CLOUDFLARE_R2_ENDPOINT=
GITHUB_PAT=
GITHUB_REPO=

