# Secrets and runtime data
.env
*.env
# .env.bak and friends: *.env only matches names *ending* in .env, so a backup
# copy of the env file stayed visible to git and blocked a deploy.
.env.*
!.env.example
data/sessions/
*.session
*.session-journal

# Runtime output
logs/
*.log
backups/
*.sql.gz
*.db
*.csv

# Python
venv/
.venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/

# Node / Evidence dashboard / Status page
node_modules/
dashboard/.evidence/
.wrangler/


# Testing
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Editors and tooling
.idea/
.vscode/
.claude/settings.local.json

# OS
.DS_Store
Thumbs.db
desktop.ini
